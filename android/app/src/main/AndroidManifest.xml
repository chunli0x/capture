<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- MWA discovers wallets by resolving this scheme. Without the queries
         entry, Android 11+ package visibility rules hide every installed
         wallet and MWA reports NoWalletFound on a device that has one. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="solana-wallet" />
        </intent>
    </queries>

    <!-- usesCleartextTraffic is for the local dev backend only.
         Remove it before any public build. -->
    <application
        android:allowBackup="false"
        android:usesCleartextTraffic="true"
        android:icon="@android:drawable/ic_menu_compass"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.TapFarm">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
